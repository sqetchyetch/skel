if [ -z "ssh -T git@github.com | grep Hello" ]; then
	exit 0
else 
	echo ' enter repo name with no spaces for ssh key..'
	readline -r repo_name
	if [ -n $repo_name ]: then
		echo $repo_name
		$repo_name=="~/.ssh/.$repo_name"
		echo $repo_name
		if [ -f "$repo_name" ]; then
			exit 1
		else
			ssh-keygen -t ed25519 -f "$repo_name"
			eval "$(ssh-agent -s)"
			ssh-add "$repo_name"
			cat "$repo_name.pub"
			echo ' '
			echo " Copy Public key to GitHub Settings SSH Key.."
		fi
	else
		echo " You must name your ssh key, leaving default may overwrite current keys.."
		exit 1
	fi
fi


