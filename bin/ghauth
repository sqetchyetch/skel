#!/bin/bash
#	1. authenticate with the github server to unlock features that require write permissions..
authenticatewithgithub() {
	if [ -n 'ssh -T git@github.com | grep successfully\ authenticated' ]; then
		exit 0
	else 
		echo ' enter repo name with no spaces for ssh key..'
		read -r repo_name

		if [ -z "$repo_name" ]; then
			echo " You must name your ssh key, leaving default may overwrite current keys.."
			exit 1
		else
			if [ -n "~/.ssh/.$repo_name" ]; then
				ssh-keygen -t ed25519 -f "$repo_name"
				eval "$(ssh-agent -s)"
				ssh-add "$repo_name"
			fi
			mv "$repo_name" "$HOME/.ssh/$repo_name"
			mv "$repo_name.pub" "$HOME/.ssh/$repo_name.pub"
			echo ' '
			echo ' \/ PUBLIC KEY \/'
			echo ' '
			cat "$HOME/.ssh/$repo_name.pub"
			echo ' '
			echo ' /\ PUBLIC KEY /\'
			echo ' '
			echo " Copy Public key to Forked GitHub Repo Settings -> Add New SSH Key.."
			echo ' '
		fi
	fi
}
authenticatewithgithub

