#!/bin/bash
savehomecfgs() {
	set -e
	echo '                                code 8, backing up global directory..'
	cp -v $HOMECFGDIR/.aliases $HOMECFGDIR/.aliases.bak
	cp -v $HOMECFGDIR/.zprofile $HOMECFGDIR/.zprofile.bak
	cp -v $HOMECFGDIR/.profile $HOMECFGDIR/.profile.bak
	cp -v $HOMECFGDIR/.zshrc $HOMECFGDIR/.zshrc.bak
	cp -v $HOMECFGDIR/.bashrc $HOMECFGDIR/.bashrc.bak
	cp -v $HOMECFGDIR/.vimrc $HOMECFGDIR/.vimrc.bak
	echo ' done..'
	echo ' '
	echo '                      code 6, moving new config files to global dir..'
	cp -v ~/.aliases $HOMECFGDIR/.aliases
	cp -v ~/.zprofile $HOMECFGDIR/.zprofile
	cp -v ~/.profile $HOMECFGDIR/.profile
	cp -v ~/.zshrc $HOMECFGDIR/.zshrc
	cp -v ~/.bashrc $HOMECFGDIR/.bashrc
	cp -v ~/.vimrc $HOMECFGDIR/.vimrc
	echo ' done..'
	echo ' '
	set +e
	# wait for human verification
	echo '      open a new terminal shell and make sure everything works okay..'
	echo ' '
	echo '   if there are no bugs, go ahead and hit ENTER to CONTINUE..'
	echo ' '
	echo '                (to CANCEL type C and press RETURN..)'
	echo ' '
	read -r response
	if [ -z "$response" ]; then
		# everything works, get rid of backups..
		set -e	
		echo ' '
		echo '                          files saved, cleaning up the temp folder..'
		rm -v $HOMECFGDIR/.aliases.bak
		rm -v $HOMECFGDIR/.zprofile.bak
		rm -v $HOMECFGDIR/.profile.bak
		rm -v $HOMECFGDIR/.zshrc.bak
		rm -v $HOMECFGDIR/.bashrc.bak
		rm -v $HOMECFGDIR/.vimrc.bak
		echo ' success!'
		echo ' '
		echo '             new config settings now available in global repository!'
		echo ' '
		set +e
	else
		# cancel was typed, return global config files to their previous state..
		set -e
		echo ' '
		echo '                        returning global configs to previous state..'
		mv -v $HOMECFGDIR/.aliases.bak $HOMECFGDIR/.aliases
		mv -v $HOMECFGDIR/.profile.bak $HOMECFGDIR/.profile
		mv -v $HOMECFGDIR/.zprofile.bak $HOMECFGDIR/.zprofile
		mv -v $HOMECFGDIR/.bashrc.bak $HOMECFGDIR/.bashrc
		mv -v $HOMECFGDIR/.zshrc.bak $HOMECFGDIR/.zshrc
		mv -v $HOMECFGDIR/.vimrc.bak $HOMECFGDIR/.vimrc
		set +e
		echo ' global configs restored..'
		echo ' '
		echo '            undo changes and give up? or keep editing home configs..'
		echo ' '
		echo '         (ENTER = undo changes / Cancel = keep editing)'
		echo ' '
		read -r response2
		if [ -z "$response2" ]; then
			# we gotta put everything back to stock bootrom option..
			set -e
			echo ' '
			echo '                               restoring home configuration files..'
			cp -v $HOMECFGDIR/.aliases ~/.aliases
			cp -v $HOMECFGDIR/.profile ~/.profile
			cp -v $HOMECFGDIR/.zprofile ~/.zprofile
			cp -v $HOMECFGDIR/.bashrc ~/.bashrc
			cp -v $HOMECFGDIR/.zshrc ~/.zshrc
			cp -v $HOMECFGDIR/.vimrc ~/.vimrc
			set +e
			echo ' home configs restored..'
			echo ' '
			echo '                              code 14, return to normal operations!'
			echo ' '
			exit 0
		else
			# files already fixed upstream, what was the problem anyway?
			echo '                                       leaving home configs alone..'
			echo ' '
			echo '                               try to fix the issue and come back..'
			echo ' '
			exit 1
		fi
	fi
}
